        <mxCell id="7" value="1: POST /api/orders (Bearer JWT, items: [{productId, qty}])" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0969da;strokeWidth=2;fontSize=11;" parent="1" edge="1">
