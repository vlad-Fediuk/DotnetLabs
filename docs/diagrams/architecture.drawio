        <mxCell id="18" value="Збереження знімка даних (Snapshotting):&lt;br/&gt;фіксація назви та ціни товару на момент купівлі" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=top;align=left;fillColor=#fff9db;strokeColor=#fab005;fontSize=10;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="580" y="525" width="230" height="40" />
        </mxCell>
        <mxCell id="19" value="7: SQL: INSERT INTO Orders (Id, UserId, TotalAmount), INSERT INTO OrderItems (..., ProductName, UnitPrice)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0969da;strokeWidth=2;fontSize=11;" parent="1" edge="1">
