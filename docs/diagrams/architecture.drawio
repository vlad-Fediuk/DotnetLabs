          </mxGeometry>
        </mxCell>
        <mxCell id="10" value="Валідація JWT токена (UserId, Role)&lt;br/&gt;та валідація DTO (FluentValidation)" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=top;align=left;fillColor=#fff9db;strokeColor=#fab005;fontSize=10;" parent="1" vertex="1">
