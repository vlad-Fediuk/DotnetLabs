        </mxCell>
        <mxCell id="8" value="Ocelot перехоплює запит,&lt;br/&gt;додає X-Correlation-Id,&lt;br/&gt;маршрутизує на порт 5100" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=top;align=left;fillColor=#fff9db;strokeColor=#fab005;fontSize=10;" parent="1" vertex="1">
