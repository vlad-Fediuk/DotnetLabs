        <mxCell id="7" value="&lt;b&gt;CatalogDb (PostgreSQL)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff3cd;strokeColor=#ffc107;dashed=1;size=40;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="960" y="80" width="160" height="720" />
        </mxCell>
        <mxCell id="8" value="&lt;b&gt;OrdersDb (PostgreSQL)&lt;/b&gt;" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#fff3cd;strokeColor=#ffc107;dashed=1;size=40;fontSize=12;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="1170" y="80" width="150" height="720" />
        </mxCell>
        <mxCell id="9" value="1: POST /api/orders (Bearer JWT, items: [{productId, qty}])" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0969da;strokeWidth=2;fontSize=11;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="150" as="sourcePoint" />
            <mxPoint x="345" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="10" value="Шлюз валідує JWT токен на межі системи.&lt;br/&gt;Інжектує X-User-Id, X-User-Role, X-Correlation-Id.&lt;br/&gt;Маршрутизує на Order Service (:5103)" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=top;align=left;fillColor=#e7f5ff;strokeColor=#1971c2;fontSize=10;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="290" y="170" width="230" height="55" />
        </mxCell>
        <mxCell id="11" value="2: POST /api/orders (Headers: X-User-Id, X-Correlation-Id, Payload)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0969da;strokeWidth=2;fontSize=11;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="345" y="245" as="sourcePoint" />
            <mxPoint x="560" y="245" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="12" value="Отримує ідентифікатор користувача з заголовка.&lt;br/&gt;Валідує структуру замовлення" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=top;align=left;fillColor=#fff9db;strokeColor=#fab005;fontSize=10;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="500" y="260" width="210" height="40" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;[МЕРЕЖЕВИЙ ВИКЛИК] Міжсервісна взаємодія (Order Service → Catalog Service)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ebf5ff;strokeColor=#1971c2;dashed=1;strokeWidth=2;align=left;verticalAlign=top;fontSize=11;fontColor=#1864ab;" parent="1" vertex="1">
          <mxGeometry as="geometry" x="520" y="315" width="560" height="200" />
        </mxCell>
        <mxCell id="14" value="3: [HTTP/gRPC] POST /api/products/reserve (ReserveStockRequest {items})" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0969da;strokeWidth=2;fontSize=11;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="560" y="355" as="sourcePoint" />
            <mxPoint x="805" y="355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="15" value="4: SQL: UPDATE Products SET StockQuantity = StockQuantity - @qty WHERE Id = @id AND StockQuantity &gt;= @qty" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0969da;strokeWidth=2;fontSize=11;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="805" y="395" as="sourcePoint" />
            <mxPoint x="1040" y="395" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="16" value="5: SQL Result: 1 рядок змінено (OK)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#57606a;fontSize=11;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
