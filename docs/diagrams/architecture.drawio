          </mxGeometry>
        </mxCell>
        <mxCell id="14" value="Локальна перевірка: StockQuantity &gt;= qty&lt;br/&gt;Розрахунок TotalAmount у пам&#39;яті процесу" style="shape=note;whiteSpace=wrap;html=1;size=12;verticalAlign=top;align=left;fillColor=#fff9db;strokeColor=#fab005;fontSize=10;" parent="1" vertex="1">
