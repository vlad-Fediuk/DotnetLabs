        <mxCell id="17" value="6: HTTP 200 OK (ReservationSuccess: true, UnitPrices: [...])" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#57606a;fontSize=11;" parent="1" edge="1">
