        </mxCell>
        <mxCell id="12" value="4: SQL: SELECT StockQuantity, Price FROM Products WHERE Id IN (...)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0969da;strokeWidth=2;fontSize=11;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
