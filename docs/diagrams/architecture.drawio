        <mxCell id="20" value="8: OK (Замовлення збережено)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#57606a;fontSize=11;" parent="1" edge="1">
