        </mxCell>
        <mxCell id="20" value="11: HTTP 201 Created (OrderResponse DTO, X-Correlation-Id)" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;strokeColor=#57606a;fontSize=11;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
